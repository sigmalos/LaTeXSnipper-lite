    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
