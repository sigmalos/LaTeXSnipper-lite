{
  "name": "latexsnipper-office",
  "private": true,
  "version": "1.1.0",
  "description": "LaTeXSnipper Office for Mac: the Word / PowerPoint add-in, built separately from the desktop app",
  "type": "module",
  "scripts": {
    "assemble": "node tools/assemble.mjs",
    "test": "node --test tests/*.test.mjs",
    "ui": "vite build --config app/vite.config.ts",
    "build": "node tools/build.mjs",
    "lint": "tsc --noEmit -p app",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/mathjax-stix2-font": "4.1.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@playwright/test": "1.65.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@xmldom/xmldom": "0.9.12",
    "mathjax": "4.1.3",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
